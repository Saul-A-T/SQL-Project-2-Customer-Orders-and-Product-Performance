-- 1. Order detail: join orders, customers, items, and products.
-- Cancelled orders are excluded from sales reporting.
SELECT
    o.order_id,
    o.order_date,
    c.customer_name,
    p.product_name,
    oi.quantity,
    oi.sale_price,
    ROUND(oi.quantity * oi.sale_price, 2) AS line_revenue
FROM orders AS o
JOIN customers AS c ON c.customer_id = o.customer_id
JOIN order_items AS oi ON oi.order_id = o.order_id
JOIN products AS p ON p.product_id = oi.product_id
WHERE o.status <> 'cancelled'
ORDER BY o.order_date, o.order_id, p.product_name;

-- 2. Revenue and item count per eligible order.
WITH order_totals AS (
    SELECT
        o.order_id,
        o.customer_id,
        o.order_date,
        SUM(oi.quantity * oi.sale_price) AS order_revenue,
        SUM(oi.quantity) AS item_count
    FROM orders AS o
    JOIN order_items AS oi ON oi.order_id = o.order_id
    WHERE o.status IN ('completed', 'shipped')
    GROUP BY o.order_id, o.customer_id, o.order_date
)
SELECT
    ot.order_id,
    ot.order_date,
    c.customer_name,
    ROUND(ot.order_revenue, 2) AS order_revenue,
    ot.item_count
FROM order_totals AS ot
JOIN customers AS c ON c.customer_id = ot.customer_id
ORDER BY ot.order_revenue DESC, ot.order_id;

-- 3. Category revenue and units sold, excluding cancelled orders.
SELECT
    p.category,
    SUM(oi.quantity) AS units_sold,
    ROUND(SUM(oi.quantity * oi.sale_price), 2) AS category_revenue
FROM orders AS o
JOIN order_items AS oi ON oi.order_id = o.order_id
JOIN products AS p ON p.product_id = oi.product_id
WHERE o.status IN ('completed', 'shipped')
GROUP BY p.category
ORDER BY category_revenue DESC, p.category;

-- 4. Customer lifetime value in this sample and number of eligible orders.
SELECT
    c.customer_id,
    c.customer_name,
    COUNT(DISTINCT o.order_id) AS order_count,
    ROUND(SUM(oi.quantity * oi.sale_price), 2) AS customer_revenue
FROM customers AS c
JOIN orders AS o ON o.customer_id = c.customer_id
JOIN order_items AS oi ON oi.order_id = o.order_id
WHERE o.status IN ('completed', 'shipped')
GROUP BY c.customer_id, c.customer_name
ORDER BY customer_revenue DESC, c.customer_name;

-- 5. Include customers with no eligible orders using LEFT JOIN.
SELECT
    c.customer_name,
    COUNT(DISTINCT CASE WHEN o.status IN ('completed', 'shipped') THEN o.order_id END) AS order_count,
    ROUND(COALESCE(SUM(CASE WHEN o.status IN ('completed', 'shipped')
        THEN oi.quantity * oi.sale_price END), 0), 2) AS customer_revenue
FROM customers AS c
LEFT JOIN orders AS o ON o.customer_id = c.customer_id
LEFT JOIN order_items AS oi ON oi.order_id = o.order_id
GROUP BY c.customer_id, c.customer_name
ORDER BY customer_revenue DESC, c.customer_name;

-- 6. Monthly revenue using a common table expression.
SELECT
    strftime('%Y-%m', o.order_date) AS order_month,
    ROUND(SUM(oi.quantity * oi.sale_price), 2) AS monthly_revenue
FROM orders AS o
JOIN order_items AS oi ON oi.order_id = o.order_id
WHERE o.status IN ('completed', 'shipped')
GROUP BY strftime('%Y-%m', o.order_date)
ORDER BY order_month;

-- 7. Rank products by revenue within each category (window function).
WITH product_revenue AS (
    SELECT
        p.product_id,
        p.product_name,
        p.category,
        SUM(oi.quantity * oi.sale_price) AS revenue
    FROM products AS p
    JOIN order_items AS oi ON oi.product_id = p.product_id
    JOIN orders AS o ON o.order_id = oi.order_id
    WHERE o.status IN ('completed', 'shipped')
    GROUP BY p.product_id, p.product_name, p.category
)
SELECT
    category,
    product_name,
    ROUND(revenue, 2) AS product_revenue,
    RANK() OVER (PARTITION BY category ORDER BY revenue DESC) AS category_rank
FROM product_revenue
ORDER BY category, category_rank, product_name;

-- 8. Compare each month's revenue with the previous month.
WITH monthly_revenue AS (
    SELECT
        strftime('%Y-%m', o.order_date) AS order_month,
        SUM(oi.quantity * oi.sale_price) AS revenue
    FROM orders AS o
    JOIN order_items AS oi ON oi.order_id = o.order_id
    WHERE o.status IN ('completed', 'shipped')
    GROUP BY strftime('%Y-%m', o.order_date)
)
SELECT
    order_month,
    ROUND(revenue, 2) AS revenue,
    ROUND(LAG(revenue) OVER (ORDER BY order_month), 2) AS previous_month_revenue,
    ROUND(revenue - LAG(revenue) OVER (ORDER BY order_month), 2) AS change_from_previous_month
FROM monthly_revenue
ORDER BY order_month;

